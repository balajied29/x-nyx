# Copy to .env and fill in. Never commit .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/xnyx
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xnyx?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/xnyx

# Port the API + dashboard listen on
PORT=4000

# Password for /dashboard
DASHBOARD_PASSWORD=change-me

# Secret used to sign the dashboard session cookie (any long random string)
SESSION_SECRET=change-me-too

# Timezone used for "today" and the daily chart
TZ_NAME=Asia/Kolkata

# Visitor numbers start at this offset + 1 (0 -> first visitor is #0001)
VISITOR_BASE=0
